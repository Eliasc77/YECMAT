        INT4 version FK
        CHAR10 area
        CHAR30 campo_id FK
        CHAR20 seccion_id FK
        CHAR1 estado_campo
        INT4 orden
        BOOLE_D activo
    }

    YMMT_DM_DATO {
        MANDT mandt PK,FK
        SYSUUID_X16 segmento_uuid PK,FK
