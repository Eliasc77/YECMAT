    YMMT_DM_FLUJO {
        MANDT mandt PK
        CHAR20 flujo_id PK
        CHAR80 descripcion
        MTART tipo_material
        CHAR1 tipo_operacion
        WERKS_D centro_criterio
        BOOLE_D activo
    }

    YMMT_DM_FLUJO_VR {
        MANDT mandt PK,FK
        CHAR20 flujo_id PK,FK
        INT4 version PK
        CHAR12 estado
        DATS vigente_desde
        DATS vigente_hasta
        SYUNAME creado_por
        TIMESTAMPL creado_el
    }

    YMMT_DM_PASO {
        MANDT mandt PK,FK
        CHAR20 flujo_id PK,FK
        INT4 version PK,FK
        CHAR20 paso_id PK
        CHAR10 area
        CHAR20 fase
        CHAR1 condicion_bpm
        INT4 orden
        BOOLE_D obligatorio
        BOOLE_D activo
    }

    YMMT_DM_SOL {
        MANDT mandt PK,FK
        SYSUUID_X16 solicitud_uuid PK
        CHAR20 numero_solicitud UK
        MTART tipo_material
        CHAR1 tipo_operacion
        MATNR material
        CHAR20 flujo_id FK
        INT4 version FK
        CHAR12 estado
        SYUNAME creado_por
        TIMESTAMPL creado_el
    }

    YMMT_DM_TAREA {
        MANDT mandt PK,FK
        SYSUUID_X16 tarea_uuid PK
        SYSUUID_X16 solicitud_uuid FK
        CHAR20 flujo_id FK
        INT4 version FK
        CHAR20 paso_id FK
        CHAR10 area
        CHAR12 estado
        SYUNAME responsable
        TIMESTAMPL creado_el
    }

    YMMT_DM_SEG {
        MANDT mandt PK,FK
        SYSUUID_X16 segmento_uuid PK
        SYSUUID_X16 solicitud_uuid FK
        CHAR10 tipo_segmento
        CHAR12 estado
    }

    YMMT_DM_SEG_CEN {
        MANDT mandt PK,FK
        SYSUUID_X16 segmento_uuid PK,FK
        WERKS_D centro
    }

    YMMT_DM_SEG_ALM {
        MANDT mandt PK,FK
        SYSUUID_X16 segmento_uuid PK,FK
        WERKS_D centro
        LGORT_D almacen
    }

    YMMT_DM_SEG_VEN {
        MANDT mandt PK,FK
        SYSUUID_X16 segmento_uuid PK,FK
        VKORG org_ventas
        VTWEG canal
    }

    YMMT_DM_SEG_VAL {
        MANDT mandt PK,FK
        SYSUUID_X16 segmento_uuid PK,FK
        BWKEY area_valoracion
        BWTAR_D tipo_valoracion
    }

    YMMT_DM_SEG_UOM {
        MANDT mandt PK,FK
        SYSUUID_X16 segmento_uuid PK,FK
        MEINS unidad_alternativa
    }

    YMMT_DM_CAMPO {
        MANDT mandt PK
        CHAR30 campo_id PK
        CHAR80 descripcion
        TABNAME tabla_sap
        FIELDNAME campo_sap
