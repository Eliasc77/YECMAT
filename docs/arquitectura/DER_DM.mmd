        CHAR10 tipo_dato
        INT4 longitud
        INT4 decimales
        CHAR30 ayuda_valores
        CHAR20 tipo_control
        BOOLE_D activo
    }

    YMMT_DM_SECCION {
        MANDT mandt PK
        CHAR20 seccion_id PK
        CHAR80 descripcion
        INT4 orden
        BOOLE_D activo
    }

    YMMT_DM_REGLA {
        MANDT mandt PK,FK
        SYSUUID_X16 regla_uuid PK
