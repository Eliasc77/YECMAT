@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Flujo', typeNamePlural: 'Flujos',
  title: { value: 'FlujoId' }, description: { value: 'Descripcion' } }
annotate view YC_DM_M_FLUJO with
{
  @UI.facet: [ { id: 'General', type: #IDENTIFICATION_REFERENCE, label: 'Datos generales', position: 10 },
    { id: 'Versiones', type: #LINEITEM_REFERENCE, label: 'Versiones', position: 20, targetElement: '_Versiones' } ]
  @UI.lineItem: [ { position: 10, label: 'Flujo' } ]
  @UI.identification: [ { position: 10, label: 'Flujo' } ]
  @UI.selectionField: [{ position: 10 }]
  FlujoId;

  @UI.lineItem: [ { position: 20, label: 'Descripcion' } ]
  @UI.identification: [ { position: 20, label: 'Descripcion' } ]
  Descripcion;

  @UI.lineItem: [ { position: 30, label: 'Tipo de material' } ]
  @UI.identification: [ { position: 30, label: 'Tipo de material' } ]
  @UI.selectionField: [{ position: 30 }]
  TipoMaterial;

  @UI.lineItem: [ { position: 40, label: 'Operacion C / M / I' } ]
  @UI.identification: [ { position: 40, label: 'Operacion C / M / I' } ]
  TipoOperacion;

  @UI.lineItem: [ { position: 50, label: 'Centro de seleccion' } ]
  @UI.identification: [ { position: 50, label: 'Centro de seleccion' } ]
  CentroCriterio;

  @UI.lineItem: [ { position: 60, label: 'Activo' } ]
  @UI.identification: [ { position: 60, label: 'Activo' } ]
  Activo;

  @UI.hidden: true
  LastChangedAt;
  @UI.hidden: true
  LocalLastChangedAt;
}
