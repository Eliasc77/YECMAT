  @UI.lineItem: [
    { position: 20, label: 'Tipo de valoracion' }
  ]
  @UI.identification: [
    { position: 20, label: 'Tipo de valoracion' }
  ]
  @UI.selectionField: [{ position: 20 }]
  TipoValoracion;

}
