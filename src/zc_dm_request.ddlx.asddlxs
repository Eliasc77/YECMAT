@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Solicitud de material',
  typeNamePlural: 'Solicitudes de material',
  title: { value: 'RequestNo' },
  description: { value: 'Status' }
}
@UI.presentationVariant: [{ sortOrder: [{ by: 'CreatedAt', direction: #DESC }] }]
annotate view ZC_DM_Request with
{
  @UI.facet: [
    { id: 'General', type: #IDENTIFICATION_REFERENCE, label: 'Solicitud', position: 10 },
    { id: 'Areas', type: #LINEITEM_REFERENCE, label: 'Áreas', position: 20,
      targetElement: '_AreaTasks' },
    { id: 'Fields', type: #LINEITEM_REFERENCE, label: 'Campos', position: 30,
      targetElement: '_FieldValues' }
  ]
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  RequestNo;
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  Operation;
  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  Plant;
  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  MaterialType;
  @UI.lineItem: [{ position: 50, criticality: 'Status' }]
  @UI.identification: [{ position: 50 }]
  Status;
}
