managed implementation in class zbp_i_dm_areatask unique;
strict ( 2 );

define behavior for ZI_DM_AreaTask alias AreaTask
persistent table zdm_req_a
lock master
authorization master ( instance )
etag master LastChangedAt
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) AreaTaskUUID;
  field ( readonly ) RequestUUID, FinishedAt,
                     LastChangedBy, LastChangedAt;
  field ( readonly : update ) Area;

  action startWork result [1] $self;
  action finishArea result [1] $self;

  mapping for zdm_req_a
  {
    AreaTaskUUID    = area_task_uuid;
    RequestUUID     = request_uuid;
    Area            = area;
    TrafficLight    = traffic_light;
    EnabledAt       = enabled_at;
    StartedAt       = started_at;
    FinishedAt      = finished_at;
    DueAt           = due_at;
    ResponsibleUser = responsible_user;
    LastChangedBy   = last_changed_by;
    LastChangedAt   = last_changed_at;
  }
}
