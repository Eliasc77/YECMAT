managed implementation in class zbp_i_dm_fieldvalue unique;
strict ( 2 );

define behavior for ZI_DM_FieldValue alias FieldValue
persistent table zdm_req_f
lock master
authorization master ( instance )
etag master LastChangedAt
{
  create;
  update;
  delete;

  field ( readonly ) FieldValueUUID, LastChangedBy, LastChangedAt;
  field ( readonly : update ) RequestUUID, Area, FieldName;

  validation validateOwnership on save { create; update; }

  mapping for zdm_req_f
  {
    FieldValueUUID = field_value_uuid;
    RequestUUID    = request_uuid;
    Area           = area;
    FieldName      = field_name;
    FieldValue     = field_value;
    ValueUnit      = value_unit;
    LastChangedBy  = last_changed_by;
    LastChangedAt  = last_changed_at;
  }
}
