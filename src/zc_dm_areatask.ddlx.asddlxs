@Metadata.layer: #CORE
annotate view ZC_DM_AreaTask with
{
  @UI.lineItem: [{ position: 10 }]
  Area;
  @UI.lineItem: [{ position: 20 }]
  TrafficLight;
  @UI.lineItem: [{ position: 30 }]
  ResponsibleUser;
  @UI.lineItem: [{ position: 40 }]
  DueAt;
  @UI.lineItem: [
    { type: #FOR_ACTION, dataAction: 'startWork', label: 'Iniciar' },
    { type: #FOR_ACTION, dataAction: 'finishArea', label: 'Finalizar área' }
  ]
  AreaTaskUUID;
}
