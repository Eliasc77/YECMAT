managed with additional save and cleanup implementation in class YBP_I_DM_M_FLUJO unique;
strict ( 2 );
with draft;

define behavior for YI_DM_M_FLUJO alias Flujo
persistent table ymmt_dm_flujo
draft table ymmt_dm_d_flujo
lock master unmanaged
total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create ( precheck );
  update;
  field ( readonly ) LastChangedAt, LocalLastChangedAt;
  field ( mandatory : create, readonly : update ) FlujoId;
  field ( mandatory, features : instance ) Descripcion, TipoMaterial, TipoOperacion;
  field ( features : instance ) CentroCriterio;
  validation validar on save { create; update; }
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validar;
    validation Version~validar;
    validation Paso~validar;
    validation Regla~validar;
  }
  association _Versiones { create; with draft; }
  mapping for ymmt_dm_flujo
  {
    FlujoId = flujo_id;
    Descripcion = descripcion;
    TipoMaterial = tipo_material;
    TipoOperacion = tipo_operacion;
    CentroCriterio = centro_criterio;
    Activo = activo;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for YI_DM_M_FLUJO_VR alias Version
