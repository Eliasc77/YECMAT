  action ( features : instance ) Retirar result [1] $self;
  action ( features : instance ) Copiar parameter YD_DM_M_COPIAR result [1] $self;
  field ( mandatory, features : instance ) VigenteDesde;
  field ( features : instance ) VigenteHasta;
  validation validar on save { create; update; }
  association _Flujo { with draft; }
  association _Pasos { create ( features : instance ); with draft; }
