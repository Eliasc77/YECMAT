{
  "name": "yecmat-dm-mantenimientos",
  "version": "0.3.0",
  "private": true,
  "description": "Mantenimiento administrativo de configuracion DM",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "fiori run --open index.html",
    "start:demo": "ui5 serve --config ui5-demo.yaml --open index.html?mode=demo",
    "build": "ui5 build --config ui5-demo.yaml --clean-dest",
    "test": "node --test test/*.test.cjs",
    "test:browser": "node --test test/browser/*.test.cjs",
    "check": "node tools/check.cjs"
  },
  "devDependencies": {
    "@sap/ux-ui5-tooling": "1.34.0",
    "@ui5/cli": "4.0.71",
    "playwright": "1.64.1"
  }
}
